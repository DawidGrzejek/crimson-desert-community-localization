# Only the translator's own files are published. Everything else in this
# folder (the base localization tool, game texts, projects, AI tasks,
# backups, settings) stays local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/cd_core.py
!/cd_translator.py
!/i18n.py
!/ai_check.py
!/lang/
!/start_translator.sh
!/requirements-translator.txt
__pycache__/
!/tools/
/tools/*
!/tools/README.md
!/tools/paz_parse.py
!/tools/paz_crypto.py
!/tools/paz_repack.py
!/tools/Meta_Patch.py
